# ==============================================================================
# xBAKE Environment Configuration Example
# ==============================================================================
# Copy this file to .env or /etc/xbake/xbake.env and customize the values.
# Never commit real credentials or production tokens to source control.
# ==============================================================================

# Path to the xBAKE JSON configuration file (optional; defaults to config.json)
# XBAKE_CONFIG=config.json

# Bearer token required for dashboard control endpoints (POST /api/*)
# Recommended whenever binding to 0.0.0.0 or deploying to a production network.
# Leave empty for local development without token authentication.
XBAKE_WEB_TOKEN=your-secure-auth-token-here
